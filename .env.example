# Token bot lấy trong Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Application ID (Client ID) trong Developer Portal > General Information
CLIENT_ID=

# ID server (guild) để đăng ký lệnh nhanh khi test. Để trống nếu deploy global.
GUILD_ID=

# ID của role Admin được phép chỉnh thời gian reset phòng / ép reset phòng.
# Nếu để trống, bot sẽ dùng quyền Discord "Administrator" của server.
ADMIN_ROLE_ID=

# (Phương án 5) ID role bắt buộc để được bấm "Gia nhập" phòng.
# Để trống nếu muốn ai cũng gia nhập được.
JOIN_ROLE_ID=

# (Phương án 4) ID kênh log riêng cho admin (ghi lại mỗi lần phát code).
# Để trống nếu không cần log riêng.
LOG_CHANNEL_ID=
