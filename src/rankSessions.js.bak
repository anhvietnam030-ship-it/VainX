// src/rankSessions.js
const sessions = new Map();
const finalizedSessions = new Map();

function createSession(roomId, players, mode, code) {
  for (const [id, s] of sessions) {
    if (s.roomId === roomId) sessions.delete(id);
  }

  const sessionId = `${roomId}-${Date.now()}`;
  sessions.set(sessionId, {
    roomId,
    players: Array.from(players.entries()),
    mode,
    code: code || null,
    createdAt: Date.now(),
    resultMap: new Map(),
    expiresAt: Date.now() + 45 * 60 * 1000,
  });
  return sessionId;
}

function getSession(sessionId) {
  const session = sessions.get(sessionId);
  if (!session) return null;
  return { id: sessionId, ...session };
}

function getActiveSessionByRoomId(roomId) {
  let latest = null;
  for (const [id, session] of sessions) {
    if (session.roomId === roomId && Date.now() < session.expiresAt) {
      if (!latest || session.createdAt > latest.createdAt) {
        latest = { id, ...session };
      }
    }
  }
  return latest;
}

function getActiveSessionForUser(userId) {
  let latest = null;
  for (const [id, session] of sessions) {
    if (Date.now() < session.expiresAt && session.players.some(([pid]) => pid === userId)) {
      if (!latest || session.createdAt > latest.createdAt) {
        latest = { id, ...session };
      }
    }
  }
  return latest;
}

function getLatestActiveSession() {
  let latest = null;
  for (const [id, session] of sessions) {
    if (Date.now() < session.expiresAt) {
      if (!latest || session.createdAt > latest.createdAt) {
        latest = { id, ...session };
      }
    }
  }
  return latest;
}

// ✅ Set mode cho session admin-test (dùng sau khi OCR đếm KDA để đoán mode).
function setSessionMode(sessionId, mode) {
  const session = sessions.get(sessionId);
  if (!session) return false;
  session.mode = mode;
  return true;
}

// ✅ Tạo session admin test — DỌN session admin-test cũ của user trước.
function createAdminTestSession(userId, username, mode = '5v5') {
  let cleaned = 0;
  for (const [id, s] of sessions) {
    if (s.roomId === 'admin-test' && s.players.some(([pid]) => pid === userId)) {
      sessions.delete(id);
      cleaned++;
    }
  }
  if (cleaned > 0) console.log(`🧪 Dọn ${cleaned} session admin-test cũ của ${username}`);

  const sessionId = `admin-test-${userId}-${Date.now()}`;
  const players = [
    [userId, { username, team: 1, ready: true, isBot: false }],
  ];
  for (let i = 1; i <= 4; i++) {
    players.push([`admin-test-bot-t1-${i}-${Date.now()}`, {
      username: `TestBot T1-${i}`, team: 1, ready: true, isBot: true,
    }]);
  }
  for (let i = 1; i <= 5; i++) {
    players.push([`admin-test-bot-t2-${i}-${Date.now()}`, {
      username: `TestBot T2-${i}`, team: 2, ready: true, isBot: true,
    }]);
  }

  sessions.set(sessionId, {
    roomId: 'admin-test',
    players,
    mode,
    code: null,
    createdAt: Date.now(),
    resultMap: new Map(),
    expiresAt: Date.now() + 5 * 60 * 1000,
    isAdminTest: true,
  });
  return sessionId;
}

function addResult(sessionId, userId, resultData) {
  const session = sessions.get(sessionId);
  if (!session) return false;
  if (Date.now() > session.expiresAt) return false;
  session.resultMap.set(userId, resultData);
  return true;
}

function finalizeSession(sessionId) {
  const session = sessions.get(sessionId);
  if (!session) return null;
  sessions.delete(sessionId);
  finalizedSessions.set(sessionId, { ...session, finalizedAt: Date.now() });
  setTimeout(() => finalizedSessions.delete(sessionId), 60 * 60 * 1000);
  return session;
}

function wasRecentlyFinalized(roomId, userId) {
  for (const [id, s] of finalizedSessions) {
    if (s.roomId === roomId && s.players.some(([pid]) => pid === userId)) {
      return { id, ...s };
    }
  }
  return null;
}

setInterval(() => {
  const now = Date.now();
  for (const [id, session] of sessions) {
    if (now > session.expiresAt) sessions.delete(id);
  }
}, 5 * 60 * 1000);

module.exports = {
  createSession,
  getSession,
  getActiveSessionByRoomId,
  getActiveSessionForUser,
  getLatestActiveSession,
  setSessionMode,
  createAdminTestSession,
  addResult,
  finalizeSession,
  wasRecentlyFinalized,
};